# The one site address. Backend, panel, storefront and nginx (deploy/render_nginx.sh) derive from it;
# a new domain or VPS = change this line, rebuild the frontend, restart.
SITE_URL=https://us.mong.ir
# Old domains whose saved URLs are ours (made relative by strip_hardcoded_domains).
OLD_SITE_HOSTS=samian.mong.ir

# SMS Provider API Keys
SMS_KEY=your_sms_key_here
SMSIR_INVOICE_TEMPLATE_ID=725839
SMSIR_INVOICE_PARAM=INVOICE
SMS_SANDBOX_KEY=your_sms_sandbox_key_here

# Payment Gateways
ZARINPAL_KEY=your_zarinpal_merchant_id
ZARINPAL_SANDBOX=false
# SnappPay: production address; while empty, SNAPPAY_STAGE_URL is used
SNAPPAY_BASE_URL=
SNAPPAY_STAGE_URL=
SNAPPAY_CLIENT_ID=mong
SNAPPAY_CLIENT_SECRET=your_snappay_client_secret
SNAPPAY_USERNAME=your_snappay_username
SNAPPAY_PASSWORD=your_snappay_password

# Samian ERP Configuration (Dev Port 8087)
# Note: Port 8086 is strictly reserved for production.
SAMIAN_BASE_URL=http://78.109.198.8:8087
SAMIAN_API_URL=http://78.109.198.8:8087
SAMIAN_USERNAME=
SAMIAN_PASSWORD=
SAMIAN_TIMEOUT=60

# Django Settings
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=True
# Extra hosts only; the SITE_URL host and localhost are always allowed.
DJANGO_ALLOWED_HOSTS=

# Legacy website DB (DadehfaOnlineShop) - read-only import source
DADEHFA_DB_HOST=
DADEHFA_DB_PORT=14334
DADEHFA_DB_NAME=DadehfaOnlineShop
DADEHFA_DB_USER=
DADEHFA_DB_PASSWORD=

# Path of pre-built images: /img when nginx serves it (deploy/nginx/), /api/img before that
PUBLIC_IMG_PATH=/img
# PUBLIC_MEDIA_BASE_URL=https://cdn.example.com   # set to move images to a CDN

# Payment hub (docs/06_payhub.md). The domain must be the one registered with SnappPay and Zarinpal.
PAYHUB_PUBLIC_URL=https://payhub.mong.ir
# SnappPay's returnURL only, on the domain registered with SnappPay (empty: PAYHUB_PUBLIC_URL)
PAYHUB_SNAPP_RETURN_URL=https://pay.mong.ir
PAYHUB_ACCEPT_KEY=
PAYHUB_ALLOWED_API_IPS=
PAYHUB_OLD_HUB_URL=
